<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>YCC ポータル</title>
    <link rel="icon" href="/favicon.ico">
    <style>
        body {
            perspective: 300px;
        }
        /* 親要素3D */
        #cube {
            position: relative;
            width: 0;
            margin: 200px auto;
            transform-style: preserve-3d;
            margin-top: 40vh;
          }
        /* 面共通CSS */
        .surface {
            position: absolute;
            width: 200px;
            height: 200px;
            border-width: 1px;
            border-style: solid;
            border-color: hsla(211, 100%, 32%, 0.25);
            background-image: url(data:image/svg+xml;base64,);
            background-repeat: no-repeat;
            background-position: center;
            background-size: 75%;
            background-color: hsla(211, 100%, 32%, 0.1);
        }
        /* 面個別CSS */
        #a {transform:   rotateY( 90deg) translateZ(   0px) translateY(-100px);}
        #b {transform:   rotateY(-90deg) translateZ( 200px) translateY(-100px);}
        #c {transform:   rotateX( 90deg) translateZ( 200px) translateX(-100px);}
        #d {transform:   rotateX(-90deg) translateZ(   0px) translateX(-100px);}
        #e {transform:translateZ(100px ) translateX(-100px) translateY(-100px);}
        #f {transform:   rotateY(180deg) translateX( 100px) translateY(-100px) translateZ(100px);}
        /* アニメーション */
        #cube {
            animation: anim 6s linear 0s infinite normal;
        }
        /* キーフレーム */
        @keyframes anim {
            100% {
                transform: rotateX(360deg) rotateY(360deg);
            }
        }
    </style>
</head>
<body>
    <div id="cube">
        <div id="a" class="surface"></div>
        <div id="b" class="surface"></div>
        <div id="c" class="surface"></div>
        <div id="d" class="surface"></div>
        <div id="e" class="surface"></div>
        <div id="f" class="surface"></div>
    </div>
  </body>
</html>
