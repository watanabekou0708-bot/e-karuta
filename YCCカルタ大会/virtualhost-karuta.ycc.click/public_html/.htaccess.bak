#</ifModule>

# 特定のUAを持ったアクセスをブロック
# 指定したロボットやスパイダーのアクセスを阻止
#<IfModule mod_rewrite.c>
#SetEnvIfNoCase ^User-Agent$ .*(bot1|bot2|bot3|bot4|bot5|bot6|) HTTP_SAFE_BADBOT
#SetEnvIfNoCase ^User-Agent$ .*(bot1|bot2|bot3|bot4|bot5|bot6|) HTTP_SAFE_BADBOT
#Deny from env=HTTP_SAFE_BADBOT
