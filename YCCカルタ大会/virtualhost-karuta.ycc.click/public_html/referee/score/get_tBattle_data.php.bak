<?php

    require_once($_SERVER['DOCUMENT_ROOT'].'/inc/dbConnect.php');

	$table = $_POST["table"];
    $ret = array('STATUS' => 'NG', 'ACCESS' => 'Failure', 'HOST' => '', 'GUEST' => '', , 'DATA' => '');

    // 抽選回数の取得
	$sql = "SELECT `hostSendMSG`, `guestSendMSG` FROM `deviceInfo` WHERE `deviceName` = 'PC'";
	$result = mysqli_query($db, $sql);
	$row = mysqli_fetch_array($result, MYSQLI_ASSOC);
	$lottery = $row["hostSendMSG"];
	$battle = $row["guestSendMSG"];
    $ret['HOST'] = $lottery;
    $ret['GUEST'] = $battle;
	mysqli_free_result($result);

	$sql = "SELECT * FROM `tBattle` WHERE `lottery` = '{$lottery}'";
	$result = mysqli_query($db, $sql);

	while($row = mysqli_fetch_array($result, MYSQLI_ASSOC)) {
		if($ret['DATA'] == "") {
			$ret['DATA'] = "{$row['battle']},{$row['table']},{$row['table_ninnzuu']}";
		} else {
			$ret['DATA'] .= ",{$row['battle']},{$row['table']},{$row['table_ninnzuu']}";
		}
		mysqli_free_result($result);
	}

    echo json_encode($ret);

	mysqli_close($db);
